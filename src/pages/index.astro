---
import BaseLayout from "../layouts/BaseLayout.astro";
import { sortedArticles } from "../data/articles";

const formatDate = (date: string) =>
  new Intl.DateTimeFormat("zh-CN", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    timeZone: "Asia/Shanghai",
  }).format(new Date(`${date}T00:00:00+08:00`));
---

<BaseLayout home>
  <section class="home-intro">
    <div class="intro-content">
    <p class="eyebrow"><span aria-hidden="true">●</span> A GARDEN OF IDEAS · 思考生长的地方</p>
    <h1>把好奇心，<br />慢慢写成<em>自己的理解。</em></h1>
    <p class="intro-copy">
      你好，我是 Yann。这里是我的公开笔记，记录技术探索、学习实践，以及与 AI 深入讨论后留下的思考。
    </p>
    <a class="browse-link" href="#knowledge-heading">翻阅笔记 <span aria-hidden="true">↓</span></a>
    <p class="intro-footnote">保持好奇，也为新的答案留一点空间。</p>
    </div>
    <div class="garden" aria-hidden="true">
      <div class="garden-orbit"></div>
      <div class="note-sheet sheet-back"></div>
      <div class="note-sheet sheet-front">
        <div class="sheet-heading"><span>FIELD NOTES</span><span>↗</span></div>
        <svg viewBox="0 0 240 200" fill="none">
          <path d="M120 179C117 135 127 85 147 36M122 146C104 122 81 103 61 99M128 109C148 91 169 78 188 76M136 74C120 59 110 43 106 29" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <path d="M119 143C80 145 58 125 56 98C84 96 110 115 119 143Z" fill="#dce5d6" stroke="currentColor" stroke-width="1.5" />
          <path d="M130 107C134 78 158 65 189 73C175 98 158 111 130 107Z" fill="#b7c9ac" stroke="currentColor" stroke-width="1.5" />
          <path d="M136 75C111 70 98 48 106 27C128 33 143 50 136 75Z" fill="#dce5d6" stroke="currentColor" stroke-width="1.5" />
          <path d="M145 44C144 21 159 10 175 10C175 30 164 43 145 44Z" fill="#b7c9ac" stroke="currentColor" stroke-width="1.5" />
          <path d="M86 180H155" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
        <p>让零散的想法，<br />长成有根的知识。</p>
        <div class="sheet-bottom"><span>LEARN · CONNECT · GROW</span><span>01</span></div>
      </div>
      <span class="garden-caption">一些记录，一点生长。</span>
    </div>
  </section>

  <section class="knowledge-index" aria-labelledby="knowledge-heading">
    <div class="section-heading">
      <div><p class="section-kicker">THE NOTEBOOK</p><h2 id="knowledge-heading">最近的笔记 <span>{sortedArticles.length.toString().padStart(2, "0")}</span></h2></div>
      <span>学习的痕迹，思考的切片。</span>
    </div>
    <ol class="article-list">
      {sortedArticles.map((article, index) => (
        <li>
          <a href={article.path}>
            <span class="article-number">{(index + 1).toString().padStart(2, "0")}</span>
            <span class="article-summary">
              <span class="note-meta"><time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time><span aria-hidden="true">/</span><span>{article.tags.join(" · ")}</span>{index === 0 && <span class="new-label">最新</span>}</span>
              <strong>{article.title}</strong>
              <span>{article.description}</span>
            </span>
            <span class="article-arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ol>
    <div class="notebook-end"><span aria-hidden="true">✳</span><p>笔记会继续更新，理解也会不断生长。</p></div>
  </section>
</BaseLayout>

<style>
  :global(body.home-page) { --ink: #263d33; --ink-soft: #657169; --paper: #f7f7f2; --line: #dedfd6; --blue: #355e46; background: var(--paper); }
  :global(.home-page .site-header), :global(.home-page .site-footer), .home-intro, .knowledge-index { width: min(calc(100% - 4rem), 1080px); }
  :global(.home-page .site-header) { min-height: 96px; }
  :global(.home-page .site-brand) { font-size: .95rem; letter-spacing: .02em; }
  :global(.home-page .brand-mark) { width: 34px; height: 34px; border-radius: 10px; background: #304e3e; color: #f7f7f2; font-family: Georgia, serif; font-size: 1.3rem; font-weight: 400; }
  :global(.home-page .site-header nav) { gap: 1.8rem; font-size: .85rem; }
  :global(.home-page .site-header nav a) { padding: .5rem 0; }
  :global(.home-page .site-footer) { min-height: 94px; font-size: .75rem; }
  .home-intro { min-height: auto; grid-template-columns: 1.6fr 1fr; align-items: center; gap: 2rem; padding: 78px 0 84px; }
  .eyebrow, .section-kicker { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .65rem; letter-spacing: .1em; font-weight: 500; }
  .eyebrow { margin: 0 0 1.7rem; color: #65765e; }
  .eyebrow > span { margin-right: .4rem; font-size: .6rem; }
  .home-intro h1 { font-size: clamp(2rem, 3.6vw, 3rem); letter-spacing: -.045em; line-height: 1.5; font-weight: 600; }
  .home-intro h1 em { color: #728260; }
  .intro-copy { max-width: 470px; margin: 1.4rem 0 1.8rem; font-size: .91rem; line-height: 1.95; }
  .browse-link { display: inline-flex; align-items: center; gap: 2rem; padding: .7rem 1.1rem; background: #304e3e; color: #fff; border-radius: 6px; font-size: .83rem; text-decoration: none; transition: background 180ms; }
  .browse-link:hover { background: #48664d; }
  .intro-footnote { margin-top: 1rem; color: var(--ink-soft); font-size: .72rem; }
  .garden { position: relative; min-height: 350px; display: grid; place-items: center; }
  .garden-orbit { position: absolute; width: 325px; height: 325px; border: 1px solid #e2e5d9; border-radius: 50%; background: radial-gradient(circle, #e9eddf 0, transparent 70%); }
  .note-sheet { width: 235px; height: 300px; border: 1px solid #dedfd3; border-radius: 3px; }
  .sheet-back { position: absolute; transform: rotate(-10deg); background: #e9ecdf; }
  .sheet-front { position: relative; transform: rotate(7deg); padding: 18px 20px; background: #fdfdf8; box-shadow: 0 12px 25px #2f42230a; color: #4c6446; }
  .sheet-heading, .sheet-bottom { display: flex; justify-content: space-between; font: .56rem/1.4 ui-monospace, monospace; letter-spacing: .12em; }
  .sheet-heading { border-bottom: 1px solid #e6e7dc; padding-bottom: 10px; }
  .sheet-heading span:last-child { font-size: .8rem; }
  .sheet-front svg { display: block; width: 100%; height: 157px; }
  .sheet-front p { margin: 0 0 17px; font-family: ui-serif, "Songti SC", SimSun, serif; font-size: .95rem; line-height: 1.7; text-align: center; letter-spacing: .12em; }
  .sheet-bottom { color: #77846a; font-size: .42rem; border-top: 1px solid #e6e7dc; padding-top: 9px; }
  .garden-caption { position: absolute; bottom: -24px; font-size: .68rem; color: #788271; letter-spacing: .12em; }
  .knowledge-index { padding-bottom: 0; }
  .section-heading { align-items: end; padding: 0 0 1.5rem; border-bottom: 1px solid #bdc6b7; }
  .section-kicker { margin: 0 0 .55rem; color: #798370; }
  .section-heading h2 { font-size: 1.35rem; font-weight: 600; letter-spacing: .02em; scroll-margin-top: 2rem; }
  .section-heading h2 span { margin-left: .5rem; padding: .15rem .4rem; border-radius: 4px; background: #e9ecdf; color: #6a795e; font: .7rem/1 ui-monospace, monospace; vertical-align: middle; }
  .section-heading > span { font-size: .76rem; }
  .article-list a { grid-template-columns: 48px 1fr 38px; gap: 1rem; padding: 30px 12px; border-radius: 6px; transition: background 180ms; }
  .article-list a:hover, .article-list a:focus-visible { background: #eeefe6; color: var(--ink); }
  .article-number { align-self: start; margin-top: 4px; font: .75rem/1.6 ui-monospace, monospace; color: #7d8978; }
  .article-summary { gap: .5rem; }
  .article-summary .note-meta { display: flex; flex-wrap: wrap; align-items: center; gap: .7rem; font-size: .69rem; }
  .note-meta time { font-family: ui-monospace, monospace; letter-spacing: .025em; }
  .new-label { font-size: .6rem; padding: 0 .35rem; color: #4e6d44; background: #e5ebdc; border-radius: 3px; }
  .article-summary strong { font-size: 1.24rem; line-height: 1.5; font-weight: 600; letter-spacing: -.02em; }
  .article-summary > span:not(.note-meta) { max-width: 740px; font-size: .84rem; line-height: 1.85; }
  .article-arrow { display: grid; place-items: center; width: 34px; height: 34px; border: 1px solid #d8dfcf; border-radius: 50%; color: #5c7350; font-size: 1.1rem; grid-column: auto; grid-row: auto; transition: background 180ms, color 180ms; }
  .article-list a:hover .article-arrow { background: #304e3e; border-color: #304e3e; color: #fff; }
  .notebook-end { display: flex; align-items: center; justify-content: center; gap: .65rem; padding: 38px 0 50px; color: #6c7a63; }
  .notebook-end > span { font-size: 1.2rem; }
  .notebook-end p { font-size: .72rem; margin: 0; }
  @media (max-width: 820px) {
    .home-intro { grid-template-columns: 1fr .65fr; gap: 1rem; padding: 58px 0 65px; }
    .garden { transform: scale(.82); transform-origin: center right; }
    .garden-orbit { width: 270px; height: 270px; }
    .home-intro h1 { font-size: clamp(1.8rem, 4.3vw, 2.5rem); }
  }
  @media (max-width: 600px) {
    :global(.home-page .site-header), :global(.home-page .site-footer), .home-intro, .knowledge-index { width: calc(100% - 2.5rem); }
    :global(.home-page .site-header) { min-height: 78px; }
    :global(.home-page .site-brand) { gap: .5rem; font-size: .8rem; }
    :global(.home-page .site-brand > span:last-child) { display: inline; }
    :global(.home-page .site-header nav) { gap: 1rem; font-size: .75rem; }
    .home-intro { grid-template-columns: 1fr; padding: 44px 0 38px; gap: 0; }
    .eyebrow { font-size: .55rem; margin-bottom: 1.4rem; }
    .home-intro h1 { font-size: clamp(1.7rem, 6.5vw, 2.5rem); line-height: 1.55; }
    .intro-copy { font-size: .84rem; margin-top: 1.1rem; }
    .garden { display: none; }
    .section-heading > span { display: none; }
    .section-heading { padding-bottom: 1.2rem; }
    .article-list a { grid-template-columns: 1fr 28px; gap: .7rem; padding: 24px 0; }
    .article-number { display: none; }
    .article-arrow { width: 28px; height: 28px; font-size: .85rem; }
    .article-summary .note-meta { gap: .5rem; font-size: .63rem; }
    .article-summary strong { font-size: 1.1rem; }
    .article-summary > span:not(.note-meta) { font-size: .8rem; }
    .notebook-end { padding: 30px 0 38px; }
  }
</style>
